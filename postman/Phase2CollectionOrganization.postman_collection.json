				{
					"name": "Get Product (schema validation)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const schemaOK = {",
									"    \"type\": \"object\",",
									"    \"properties\": {",
									"        \"id\": { \"type\": \"number\" },",
									"        \"title\": { \"type\": \"string\" },",
									"        \"price\": { \"type\": \"number\" },",
									"        \"brand\": { \"type\": \"string\" },",
									"        \"stock\": { \"type\": \"number\" },",
									"    },",
									"    \"required\": [\"id\", \"title\", \"price\", \"brand\", \"stock\"]  ",
									"};",
									"",
									"const schemaERROR = {",
									"    \"type\": \"object\",",
									"    \"properties\": {",
									"        \"message\": { \"type\": \"string\" }",
									"    },",
									"    \"required\": [\"message\"]",
									"};",
									"",
									"if (pm.response.code == 200) {",
									"    pm.test(\"Response body matches schema\", function () {",
									"    pm.response.to.have.jsonSchema(schemaOK);",
									"    });",
									"} else {",
									"    pm.test(\"Response body matches schema\", function () {",
									"    pm.response.to.have.jsonSchema(schemaERROR);",
									"    });",
									"};"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
