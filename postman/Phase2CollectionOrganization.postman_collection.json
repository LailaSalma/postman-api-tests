							"listen": "test",
							"script": {
								"exec": [
									"// pm.test(\"Status code is 200\", function () {",
									"//     pm.response.to.have.status(200);",
									"// })",
									"",
									"pm.test(\"Status matches expected for this row\", function () {",
									"    const expected = Number(pm.iterationData.get(\"expectedStatus\"));",
									"    pm.expect(pm.response.code).to.eql(expected);",
									"});",
									"",
									"if (pm.response.code == 200) {",
									"    pm.test(\"Product has an id\", function () {",
									"    const body = pm.response.json();",
									"    pm.expect(body).to.have.property(\"id\");",
									"    });",
									"",
									"pm.test(\"Stock is a number greater than or equal to 0\", function () {",
									"    const body = pm.response.json();",
									"    pm.expect(body.stock).to.be.a(\"number\")",
									"    pm.expect(body.stock).to.be.at.least(0);",
									"    });",
									"};",
									"",
									"",
									""
								],
